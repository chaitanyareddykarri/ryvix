# ==============================================================================
# RYVIX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: This file contains NO REAL SECRETS. Copy to .env for local development.
# Never commit .env or actual production credentials into version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
# Dedicated server-only OTP encryption key: 32 random bytes as 64 hex characters.
AUTH_CHALLENGE_SECRET=
PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Supabase Foundation (Auth, Postgres, Realtime, Storage)
# ------------------------------------------------------------------------------
# Supabase project URL and anon public key (safe for client-side web application)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase service role key (STRICTLY backend only, bypasses RLS for orchestrator)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct PostgreSQL connection string (pooled and direct, for backend migrations/workers)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage bucket names
SUPABASE_STORAGE_BUCKET_PREVIEWS=previews
SUPABASE_STORAGE_BUCKET_ARTIFACTS=artifacts

# ------------------------------------------------------------------------------
# Ryvix AI Model & Inference Layer (Hugging Face / LLM Gateway)
# ------------------------------------------------------------------------------
# Configure at least one supported external gateway provider. Reuse an existing key.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# GitHub Integration (OAuth App / GitHub App)
# ------------------------------------------------------------------------------
# Current browser OAuth flow; repository execution uses a persisted Vault connection.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Server-only random secret (at least 32 characters). Configure matching GitHub
# deployment_status webhook at /api/webhooks/github; never share it with tenants.
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Communication Integrations: WhatsApp
# ------------------------------------------------------------------------------
# Connect each Meta phone ID and access token through /channels into Vault.
# Server-wide app secret, verify token and Graph version appear below.

# ------------------------------------------------------------------------------
# Communication Integrations: Gmail (Notification / Comm Channel)
# ------------------------------------------------------------------------------
# Client credentials appear below; callback is RYVIX_PUBLIC_URL + /api/channels/gmail.

# ------------------------------------------------------------------------------
# Transactional Email (Auth OTP, Verification, Password Recovery)
# ------------------------------------------------------------------------------
# Used by application email OTP and notification workers. Hosted Supabase Auth
# mail settings are separate and must be configured in Supabase if used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# Ryvix Worker & Workspace Engine
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
WORKSPACE_STORAGE_ROOT=/tmp/ryvix/workspaces
# A real dedicated HTTPS wildcard domain; .local/localhost are rejected.
PREVIEW_BASE_DOMAIN=
PREVIEW_SIGNING_SECRET=
PREVIEW_GATEWAY_PORT=8081

# ------------------------------------------------------------------------------
# User Server Connectors (Internal & External Out-of-Band)
# ------------------------------------------------------------------------------
CONNECTOR_ENROLLMENT_SECRET=your-connector-enrollment-secret-placeholder
CONNECTOR_JWT_SECRET=your-connector-jwt-signing-secret-placeholder
CONNECTOR_TELEMETRY_PORT=8443
EXTERNAL_PROBE_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# Real execution and provider adapters
# ------------------------------------------------------------------------------
# Comma-separated approved runner images; leave empty to use the built-in list.
RYVIX_WORKSPACE_IMAGES=
# Approved images must contain Git, CA certificates and the detected stack runtime.
RYVIX_WORKSPACE_NODE_IMAGE=
RYVIX_WORKSPACE_PYTHON_IMAGE=
RYVIX_WORKSPACE_GOLANG_IMAGE=
RYVIX_WORKSPACE_RUST_IMAGE=
# Build infrastructure/workspaces/Dockerfile.egress and add its image to RYVIX_WORKSPACE_IMAGES.
# The trusted CONNECT broker restricts GitHub/registry hosts and rejects private destinations.
RYVIX_WORKSPACE_EGRESS_IMAGE=
# Trusted TCP relay; customer code remains on an internal-only network.
RYVIX_PREVIEW_RELAY_IMAGE=node:22-alpine
# Optional CA PEM for the database; TLS certificate verification remains enabled.
DATABASE_CA_CERT=
# Format: serverUUID:provider:providerInstanceId,serverUUID:provider:providerInstanceId
RYVIX_CLOUD_TARGETS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DIGITALOCEAN_TOKEN=
HETZNER_TOKEN=
GCP_ACCESS_TOKEN=

# Production deployment runner (self-hosted Linux runner)
RYVIX_DEPLOY_ENABLED=false
RYVIX_RUNTIME_ENV_FILE=
RYVIX_HEALTH_URL=https://your-production-host.example/api/health
RYVIX_HTTP_PORT=3000
# Public HTTPS origin (no path/query); required for production Google OAuth callbacks
# as well as outbound links. Configure Google client ID/secret in Supabase Auth,
# never in NEXT_PUBLIC variables. See docs/integrations/GOOGLE_LOGIN.md.
RYVIX_PUBLIC_URL=
# {"version":"x.y.z","linux":{"amd64":{"url":"versioned HTTPS URL","sha256":"64 lowercase hex"},"arm64":{"url":"versioned HTTPS URL","sha256":"64 lowercase hex"}}}
RYVIX_AGENT_RELEASE_MANIFEST=
# Optional absolute native binary path for local collection; no synthetic fallback.
RYVIX_AGENT_BINARY=
# Run one dedicated Docker-host worker with npm run worker:workspaces.
# Queue, OTP and protected-workflow migrations must be applied before rollout.
# Optional chat provider pin: groq, openai, claude, gemini, huggingface, ollama.
# Leave empty to use the configured provider failover order. Keys remain server-only.
RYVIX_CHAT_PROVIDER=
GROQ_MODEL=
OPENAI_MODEL=
CLAUDE_MODEL=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
HUGGINGFACE_MODEL=
OLLAMA_MODEL=
# Optional saved classifier weight path; dimensions, labels and tensors are validated.
RYVIX_NEURAL_WEIGHTS_PATH=
# Communication channels: use /channels after configuring provider apps.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Stable ID unique to each Docker host; web and workers share the domain map.
RYVIX_WORKER_HOST_ID=
# Example: {"worker-a":"a.preview.example.com","worker-b":"b.preview.example.com"}
RYVIX_WORKER_PREVIEW_DOMAINS=
# Optional approved service restarts: Ed25519 PKCS8 DER encoded as base64.
# Pin its public SPKI key independently in each agent's private configuration.
RYVIX_COMMAND_PRIVATE_KEY=
RYVIX_COMMAND_SERVICES=
# Dedicated operations worker. Enable only after provisioning the matching providers.
RYVIX_CLOUD_RECOVERY_ENABLED=false
RYVIX_WHATSAPP_ALERTS_ENABLED=false
# Operator-managed consent records: existing tenant connector, recipient, approved template.
# Template body must have exactly one text parameter: the incident UUID.
# [{"connectorId":"UUID","recipient":"countrycodeandnumber","template":"ryvix_p1","language":"en_US","optedIn":true}]
RYVIX_WHATSAPP_ALERT_TARGETS=[]
# Operational alerts to verified account email (Gmail recipients supported).
RYVIX_EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP is the default and uses the SMTP_* settings above. No Resend account needed.
RYVIX_NOTIFICATION_PROVIDER=smtp
# Optional only when explicitly selecting provider=resend.
RYVIX_NOTIFICATION_RESEND_KEY=
# Bare authorized sender email; defaults to SMTP_USER for Gmail SMTP.
RYVIX_NOTIFICATION_FROM=
# Separate bounded experience worker; each project must also opt in at /experience.
RYVIX_EXPERIENCE_COLLECTION_ENABLED=false
# Optional repository text indexing by the same worker; each repository must opt in.
RYVIX_REPOSITORY_KNOWLEDGE_ENABLED=false
# WhatsApp authentication template with body code and copy-code URL button.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=en_US
# Independent random secret of at least 32 characters; never expose to the browser.
WHATSAPP_OTP_SECRET=
# Separate assistant worker; each verified user must opt in through /channels/assistant.
RYVIX_WHATSAPP_ASSISTANT_ENABLED=false
# Approved utility template with one body parameter (update UUID) and fixed dashboard URL.
# Used only for opted-in task notifications outside the service window.
WHATSAPP_ASSISTANT_UPDATE_TEMPLATE=
WHATSAPP_ASSISTANT_UPDATE_LANGUAGE=en_US

# Optional Gmail polling. Only explicitly listed connected accounts are polled.
RYVIX_GMAIL_POLL_ENABLED=false
RYVIX_GMAIL_POLL_CONNECTORS=
# Optional authenticated Pub/Sub; audience is the exact public webhook URL.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
# Optional embeddings of opted-in, bounded, sanitized repository snapshots.
RYVIX_REPOSITORY_SEMANTIC_ENABLED=false
# Uses GEMINI_API_KEY; select a supported embedding model explicitly.
GEMINI_EMBEDDING_MODEL=
# Exact provider:model keys. Rates per million tokens; estimates, never invoices.
# {"provider:model":{"version":"YYYY-MM-DD","currency":"USD","inputPerMillion":0,"outputPerMillion":0}}
RYVIX_MODEL_RATES_JSON=
# Optional P1 Slack/PagerDuty/Twilio SMS. Secrets reside in Vault, not this list.
RYVIX_INCIDENT_NOTIFICATIONS_ENABLED=false
# [{"id":"UUID","environmentId":"UUID","ownerId":"UUID","provider":"slack","destination":"C_CHANNEL_ID","vaultSecretRef":"UUID","optedIn":true}]
RYVIX_INCIDENT_NOTIFICATION_TARGETS=[]
# Optional signed SMS delivery callbacks; requires exact RYVIX_PUBLIC_URL on web/worker.
RYVIX_TWILIO_STATUS_ENABLED=false
# Optional read-only incident reconciliation; PagerDuty Vault JSON needs routingKey, apiToken, serviceId.
RYVIX_PAGERDUTY_STATUS_ENABLED=false
