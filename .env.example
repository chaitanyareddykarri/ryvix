# ==============================================================================
# RYVIX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: This file contains NO REAL SECRETS. Copy to .env for local development.
# Never commit .env or actual production credentials into version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
# Dedicated server-only OTP encryption key: 32 random bytes as 64 hex characters.
AUTH_CHALLENGE_SECRET=
PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Supabase Foundation (Auth, Postgres, Realtime, Storage)
# ------------------------------------------------------------------------------
# Supabase project URL and anon public key (safe for client-side web application)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase service role key (STRICTLY backend only, bypasses RLS for orchestrator)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct PostgreSQL connection string (pooled and direct, for backend migrations/workers)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage bucket names
SUPABASE_STORAGE_BUCKET_PREVIEWS=previews
SUPABASE_STORAGE_BUCKET_ARTIFACTS=artifacts

# ------------------------------------------------------------------------------
# Ryvix AI Model & Inference Layer (Hugging Face / LLM Gateway)
# ------------------------------------------------------------------------------
# Hugging Face endpoint configuration
HUGGINGFACE_API_KEY=hf_your_huggingface_api_token_placeholder
HUGGINGFACE_ENDPOINT_URL=https://api-inference.huggingface.co/models/ryvix/ryvix-orchestrator-v1
AI_MODEL_NAME=ryvix/ryvix-orchestrator-v1
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Optional fallback inference provider (e.g. OpenAI/Anthropic gateway for local testing)
FALLBACK_AI_PROVIDER=
FALLBACK_AI_API_KEY=

# ------------------------------------------------------------------------------
# GitHub Integration (OAuth App / GitHub App)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_CLIENT_ID=your-github-client-id
GITHUB_APP_CLIENT_SECRET=your-github-client-secret
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
# Server-only random secret (at least 32 characters). Configure matching GitHub
# deployment_status webhook at /api/webhooks/github; never share it with tenants.
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Communication Integrations: WhatsApp
# ------------------------------------------------------------------------------
# WhatsApp Cloud API / Twilio / Business provider configuration
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_API_KEY=your-whatsapp-api-key-placeholder
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ------------------------------------------------------------------------------
# Communication Integrations: Gmail (Notification / Comm Channel)
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback/gmail

# ------------------------------------------------------------------------------
# Transactional Email (Auth OTP, Verification, Password Recovery)
# ------------------------------------------------------------------------------
# Note: Distinct from Gmail communication channel to support high-volume auth delivery
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-api-key-placeholder
EMAIL_FROM="Ryvix Auth <no-reply@ryvix.io>"

# ------------------------------------------------------------------------------
# Ryvix Worker & Workspace Engine
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
WORKSPACE_STORAGE_ROOT=/tmp/ryvix/workspaces
# A real dedicated HTTPS wildcard domain; .local/localhost are rejected.
PREVIEW_BASE_DOMAIN=
PREVIEW_SIGNING_SECRET=
PREVIEW_GATEWAY_PORT=8081

# ------------------------------------------------------------------------------
# User Server Connectors (Internal & External Out-of-Band)
# ------------------------------------------------------------------------------
CONNECTOR_ENROLLMENT_SECRET=your-connector-enrollment-secret-placeholder
CONNECTOR_JWT_SECRET=your-connector-jwt-signing-secret-placeholder
CONNECTOR_TELEMETRY_PORT=8443
EXTERNAL_PROBE_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# Real execution and provider adapters
# ------------------------------------------------------------------------------
# Comma-separated approved runner images; leave empty to use the built-in list.
RYVIX_WORKSPACE_IMAGES=
# Approved images must contain Git, CA certificates and the detected stack runtime.
RYVIX_WORKSPACE_NODE_IMAGE=
RYVIX_WORKSPACE_PYTHON_IMAGE=
RYVIX_WORKSPACE_GOLANG_IMAGE=
RYVIX_WORKSPACE_RUST_IMAGE=
# Build infrastructure/workspaces/Dockerfile.egress and add its image to RYVIX_WORKSPACE_IMAGES.
# The trusted CONNECT broker restricts GitHub/registry hosts and rejects private destinations.
RYVIX_WORKSPACE_EGRESS_IMAGE=
# Trusted TCP relay; customer code remains on an internal-only network.
RYVIX_PREVIEW_RELAY_IMAGE=node:22-alpine
# Optional CA PEM for the database; TLS certificate verification remains enabled.
DATABASE_CA_CERT=
# Format: serverUUID:provider:providerInstanceId,serverUUID:provider:providerInstanceId
RYVIX_CLOUD_TARGETS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DIGITALOCEAN_TOKEN=
HETZNER_TOKEN=
GCP_ACCESS_TOKEN=

# Production deployment runner (self-hosted Linux runner)
RYVIX_DEPLOY_ENABLED=false
RYVIX_RUNTIME_ENV_FILE=
RYVIX_HEALTH_URL=https://your-production-host.example/api/health
RYVIX_HTTP_PORT=3000
# Public HTTPS origin and server-managed JSON release manifest (no secrets).
RYVIX_PUBLIC_URL=
# {"version":"x.y.z","linux":{"amd64":{"url":"versioned HTTPS URL","sha256":"64 lowercase hex"},"arm64":{"url":"versioned HTTPS URL","sha256":"64 lowercase hex"}}}
RYVIX_AGENT_RELEASE_MANIFEST=
# Optional absolute native binary path for local collection; no synthetic fallback.
RYVIX_AGENT_BINARY=
# Run one dedicated Docker-host worker with npm run worker:workspaces.
# Queue, OTP and protected-workflow migrations must be applied before rollout.
