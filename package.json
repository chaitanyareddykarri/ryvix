{
  "name": "ryvix-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Ryvix Autonomous Software & Infrastructure Operations Platform",
  "workspaces": [
    "packages/*",
    "web",
    "backend",
    "ai",
    "services"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && tsx tests/run-all.ts",
    "test:e2e": "tsx tests/run-all.ts",
        "dev": "npm run dev --workspace=@ryvix/web",
    "train": "npm run train:ai && npm run train:deep",
    "train:all": "npm run train:ai && npm run train:deep",
    "train:ai": "tsx ai/scripts/train-local-model.ts",
    "train:deep": "tsx ai/scripts/deep-train-ai.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}