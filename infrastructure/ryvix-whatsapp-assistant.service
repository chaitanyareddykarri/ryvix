[Unit]
Description=Ryvix authorized WhatsApp assistant
After=network-online.target
Wants=network-online.target

[Service]
Environment=NODE_ENV=production
Type=simple
User=ryvix-worker
WorkingDirectory=/opt/ryvix/current
EnvironmentFile=/etc/ryvix/whatsapp-assistant.env
ExecStart=/usr/bin/node --import tsx scripts/whatsapp-assistant-worker.ts
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
TimeoutStopSec=180
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
