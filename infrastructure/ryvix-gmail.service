[Unit]
PartOf=ryvix-workers.target
Description=Ryvix opted-in Gmail inbox polling
After=network-online.target
Wants=network-online.target

[Service]
Environment=NODE_ENV=production
Type=simple
User=ryvix-worker
WorkingDirectory=/opt/ryvix/current
EnvironmentFile=/etc/ryvix/gmail.env
ExecStart=/usr/bin/node --import tsx scripts/gmail-worker.ts
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
TimeoutStopSec=180
MemoryMax=512M

[Install]
WantedBy=multi-user.target
