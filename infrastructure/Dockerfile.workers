FROM node:22-alpine
RUN apk add --no-cache docker-cli ca-certificates
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json web/package.json
COPY ai/package.json ai/package.json
COPY backend/package.json backend/package.json
COPY services/package.json services/package.json
COPY packages/database/package.json packages/database/package.json
COPY tools/next-root-glob tools/next-root-glob
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node ai/src ai/src
COPY --chown=node:node backend/src backend/src
COPY --chown=node:node services/src services/src
COPY --chown=node:node packages/database/src packages/database/src
COPY --chown=node:node scripts scripts
COPY tsconfig.base.json ./
RUN mkdir -p ai/data && chown node:node ai/data
USER node
CMD ["node", "scripts/worker-entry.mjs", "workspace"]
