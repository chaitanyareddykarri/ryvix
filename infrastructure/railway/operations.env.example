# Set privately in Railway. Do not commit populated values.
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=256
RYVIX_WORKER_POOL_MAX=2
DATABASE_URL=
DATABASE_CA_CERT=
RYVIX_PUBLIC_URL=https://ryvix.co.in
RYVIX_HOST_LOGS_ENABLED=false
RYVIX_CLOUD_RECOVERY_ENABLED=false
RYVIX_WHATSAPP_ALERTS_ENABLED=false
RYVIX_EMAIL_NOTIFICATIONS_ENABLED=false
RYVIX_INCIDENT_NOTIFICATIONS_ENABLED=false
RYVIX_PAGERDUTY_STATUS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
