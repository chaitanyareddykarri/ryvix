# Local Windows worker only. Copy to ignored .env.workspace.local at repository root.
# Never import this file into Railway. Keep Docker Desktop in Linux container mode.
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=256
DATABASE_URL=
DATABASE_CA_CERT=
RYVIX_PUBLIC_URL=https://ryvix.co.in
RYVIX_WORKER_HOST_ID=local-desktop-1
RYVIX_WORKSPACE_MODE=static
RYVIX_WORKSPACE_MAX_SESSIONS=1
RYVIX_WORKSPACE_MEMORY_BUDGET_MB=320
RYVIX_WORKSPACE_CPU_BUDGET=0.75
RYVIX_WORKER_POOL_MAX=2
RYVIX_WORKSPACE_STATIC_IMAGE=ryvix-micro-static:local
RYVIX_PREVIEW_RELAY_IMAGE=ryvix-micro-static:local
RYVIX_WORKSPACE_IMAGES=ryvix-micro-static:local
PREVIEW_GATEWAY_PORT=8081
# Complete only after wildcard HTTPS routing to local 127.0.0.1:8081 is ready.
PREVIEW_BASE_DOMAIN=
RYVIX_WORKER_PREVIEW_DOMAINS=
PREVIEW_SIGNING_SECRET=
RYVIX_MODEL_PROVIDER=
RYVIX_MODEL_FALLBACK_ORDER=
GEMINI_MODEL=
GEMINI_API_KEY=
GROQ_MODEL=
GROQ_API_KEY=
RYVIX_MODEL_CONTEXT_CHAR_BUDGET=2000000
