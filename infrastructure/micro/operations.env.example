# /etc/ryvix/operations.env: owner UID 1000, mode 0600; no customer code execution.
DATABASE_URL=
DATABASE_CA_CERT=
RYVIX_PUBLIC_URL=https://YOUR-APP-DOMAIN
RYVIX_HOST_LOGS_ENABLED=false
RYVIX_CLOUD_RECOVERY_ENABLED=false
RYVIX_WHATSAPP_ALERTS_ENABLED=false
RYVIX_EMAIL_NOTIFICATIONS_ENABLED=false
RYVIX_INCIDENT_NOTIFICATIONS_ENABLED=false
RYVIX_PAGERDUTY_STATUS_ENABLED=false
# Configure SMTP only when enabling application email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Remaining channel/provider settings: see root .env.example; enable one at a time.
