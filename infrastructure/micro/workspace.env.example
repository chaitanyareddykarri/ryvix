# Copy to /etc/ryvix/workspace.env, owner UID 1000, mode 0600. Never commit real values.
# Use a direct or SESSION pooler URL (port 5432): this worker holds an advisory lock.
DATABASE_URL=
DATABASE_CA_CERT=
RYVIX_WORKER_HOST_ID=micro-static-1
RYVIX_PUBLIC_URL=https://YOUR-APP-DOMAIN
PREVIEW_BASE_DOMAIN=preview.YOUR-SEPARATE-DOMAIN
RYVIX_WORKER_PREVIEW_DOMAINS={"micro-static-1":"preview.YOUR-SEPARATE-DOMAIN"}
# Same 64-hex secret on Vercel and this worker; generate privately.
PREVIEW_SIGNING_SECRET=
PREVIEW_GATEWAY_PORT=8081
# Use the published static image digest for both static and trusted Node relay.
RYVIX_WORKSPACE_STATIC_IMAGE=
RYVIX_PREVIEW_RELAY_IMAGE=
RYVIX_WORKSPACE_IMAGES=
RYVIX_MODEL_PROVIDER=
RYVIX_MODEL_FALLBACK_ORDER=
GEMINI_MODEL=
GEMINI_API_KEY=
GROQ_MODEL=
GROQ_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
RYVIX_MODEL_CONTEXT_CHAR_BUDGET=64000
