# Set privately in Vercel project settings. Root directory web, Node 22, Fluid compute.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://ryvix.co.in
RYVIX_PUBLIC_URL=https://ryvix.co.in
# GitHub OAuth authorize route uses this origin for /api/auth/github/callback.
APP_BASE_URL=https://ryvix.co.in
SUPABASE_SERVICE_ROLE_KEY=
# Use hosted pooled PostgreSQL, verified TLS; max is PER function process.
DATABASE_URL=
DATABASE_CA_CERT=
RYVIX_WEB_POOL_MAX=2
AUTH_CHALLENGE_SECRET=
CONNECTOR_ENROLLMENT_SECRET=
CONNECTOR_JWT_SECRET=
PREVIEW_SIGNING_SECRET=
RYVIX_WORKER_PREVIEW_DOMAINS={"micro-static-1":"preview.YOUR-SEPARATE-DOMAIN"}
RYVIX_MODEL_PROVIDER=
GEMINI_MODEL=
GEMINI_API_KEY=
RYVIX_MODEL_CONTEXT_CHAR_BUDGET=64000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Additional enabled OAuth/SMTP/provider settings must be copied from .env.example.
