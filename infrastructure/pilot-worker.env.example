# Copy into protected per-worker files; use only credentials needed by that worker.
NODE_ENV=production
RYVIX_WORKER_POOL_MAX=2
RYVIX_WORKSPACE_MAX_SESSIONS=1
RYVIX_WORKSPACE_MEMORY_BUDGET_MB=4608
RYVIX_WORKSPACE_CPU_BUDGET=2
# Explicit choice/model are required by deployment preflight. No paid fallback.
RYVIX_MODEL_PROVIDER=
# To enable approved Gemini -> Groq fallback, set gemini,groq and configure both models/keys.
RYVIX_MODEL_FALLBACK_ORDER=
GEMINI_MODEL=
GROQ_MODEL=
# DATABASE_URL, provider credentials, signing keys and image digests belong only
# in protected configuration. Complete the applicable settings from .env.example.
